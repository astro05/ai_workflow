{
  "disableAllHooks": false,
  "permissions": {
    "additionalDirectories": ["../ProjectKB"],
    "allow": [
      "Bash(bash .ai/scripts/validate-specs.sh)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git commit --amend:*)",
      "Bash(sudo:*)",
      "Bash(terraform destroy:*)",
      "Bash(pulumi destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(gh release create:*)",
      "Bash(gh pr merge:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/.npmrc)",
      "Read(./**/.pypirc)",
      "Read(./**/credentials.json)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pfx)",
      "Edit(./**/id_rsa*)",
      "Edit(./**/id_ed25519*)",
      "Edit(./**/.npmrc)",
      "Edit(./**/.pypirc)",
      "Edit(./**/credentials.json)",

      "Edit(./.ai/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.gemini/settings.json)",
      "Edit(./.cursor/**)",
      "Edit(./.codex/**)",
      "Edit(./opencode.json)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(dotnet add:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/policy-guard.ps1\"; if command -v pwsh >/dev/null 2>&1; then exec pwsh -NoProfile -ExecutionPolicy Bypass -File \"$h\"; elif command -v powershell >/dev/null 2>&1; then exec powershell -NoProfile -ExecutionPolicy Bypass -File \"$h\"; else echo 'Blocked: the policy hook needs PowerShell. Install PowerShell 7 (pwsh); see .ai/hooks/README.md.' >&2; exit 2; fi"
          }
        ]
      }
    ]
  }
}
